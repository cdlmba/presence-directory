---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page is not in The Presence Directory.">
  <article class="prose-wrap">
    <p class="kicker">404</p>
    <h1>This page is not here.</h1>
    <p class="lead">The link may be old, or the listing may not be published yet.</p>
    <div class="actions">
      <a class="btn" href="/">Back home</a>
      <a class="btn btn-secondary" href="/listings">View listings</a>
    </div>
  </article>
</BaseLayout>
