---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Presence Checklist"
  description="The Presence Checklist for executive dads. Placeholder until Christopher pastes the checklist as-is."
>
  <article class="prose-wrap">
    <p class="kicker">DIY next step</p>
    <h1>The Presence Checklist</h1>
    <p class="lead">
      This is the free checklist offered at the end of The Presence Audit. Until the full list is pasted in, this page holds the marked placeholder only.
    </p>
    <aside class="checklist-placeholder" role="note" aria-label="Checklist placeholder">
      <p class="kicker">Placeholder. Paste below this label.</p>
      <p class="checklist-copy">Christopher to paste Presence Checklist as-is</p>
    </aside>
  </article>
</BaseLayout>
