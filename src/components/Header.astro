---
import { BASE_PATH, path as sitePath } from '../lib/paths';

const pathname = Astro.url.pathname.replace(/\/$/, '') || BASE_PATH;

const links = [
  { route: '/', label: 'Home' },
  { route: '/listings', label: 'Listings' },
  { route: '/audit', label: 'The Presence Audit' },
  { route: '/checklist', label: 'Checklist' },
  { route: '/submit', label: 'Submit a system' },
];

function isCurrent(route: string) {
  const target = sitePath(route).replace(/\/$/, '') || BASE_PATH;
  if (route === '/') {
    return pathname === target || pathname === BASE_PATH;
  }
  return pathname === target || pathname.startsWith(`${target}/`);
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href={sitePath('/')}>
      <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
        <rect width="40" height="40" rx="3" fill="#1b2f28"></rect>
        <path d="M8 30V16.5L20 8l12 8.5V30H8Z" fill="none" stroke="#f3eee4" stroke-width="1.6"></path>
        <rect x="17.2" y="20" width="5.6" height="10" fill="#c47a52"></rect>
      </svg>
      <span class="wordmark-text">
        <span class="wordmark-kicker">The Systems Dad</span>
        <span class="wordmark-name">The Presence Directory</span>
      </span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={sitePath(link.route)} aria-current={isCurrent(link.route) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
